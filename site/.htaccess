# Locksan Safety - Apache / cPanel ayarları
Options -MultiViews
DirectorySlash Off
RewriteEngine On

# www'ye yönlendir (Wix'teki gibi)
RewriteCond %{HTTP_HOST} ^locksansafety\.com$ [NC]
RewriteRule ^(.*)$ https://www.locksansafety.com/$1 [R=301,L]
# HTTPS'e yönlendir
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Katalog PDF (eski Wix adresi)
RewriteRule ^_files/ugd/5ea3ff_eae24ac7305849b7a82f1d656b103fb9\.pdf$ /assets/locksan-eked-katalog.pdf [R=302,L]

# Kopya içerik birleştirmeleri (301)
RewriteRule ^post/bursa\-etiketleme\-kilitleme\-ürünleri\-1$ /post/bursa-etiketleme-kilitleme-%C3%BCr%C3%BCnleri [R=301,L,NE]
RewriteRule ^post/denetle\-eked\-dogrulama\-adimi$ /post/dene-eked-test-adimi [R=301,L,NE]

# Sondaki / işaretini kaldır
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Temiz URL: /sayfa -> sayfa.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
